{
  "name": "openpwr",
  "version": "0.6.0",
  "description": "An open, reproducible 1000 MWe PWR system-dynamics laboratory and interactive control room",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs --source",
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/verify.mjs && node scripts/benchmark.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "build": "node scripts/build.mjs",
    "simulate": "node scripts/simulate.mjs",
    "engineering:setup": "node scripts/engineering.mjs setup",
    "engineering:build": "node scripts/engineering.mjs build",
    "engineering:start": "node scripts/engineering.mjs start",
    "engineering:test": "node scripts/engineering.mjs test",
    "engineering:verify": "node scripts/engineering.mjs verify",
    "engineering:experiment": "node scripts/engineering.mjs experiment",
    "engineering:profile": "node scripts/engineering.mjs profile",
    "engineering:measured": "node scripts/engineering.mjs measured",
    "engineering:pressurizer": "node scripts/engineering.mjs pressurizer",
    "check": "npm run test && npm run verify && npm run build",
    "engineering:plant:build": "node scripts/engineering.mjs build-plant",
    "engineering:plant:start": "node scripts/engineering.mjs start --model plant",
    "engineering:plant:verify": "node scripts/engineering.mjs verify-plant",
    "engineering:plant:experiment": "node scripts/engineering.mjs experiment --model plant"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ajayasai/OpenPWR.git"
  }
}
